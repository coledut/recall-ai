{
  "name": "@recall/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js",
    "./client": "./dist/client.js"
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg"
  },
  "dependencies": {
    "@recall/core": "workspace:*",
    "drizzle-orm": "^0.29.1",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.7",
    "typescript": "^5.3.3"
  }
}
