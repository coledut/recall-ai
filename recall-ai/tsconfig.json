{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@recall/core": ["packages/core/src"],
      "@recall/capture": ["packages/capture/src"],
      "@recall/ai": ["packages/ai/src"],
      "@recall/db": ["packages/db/src"],
      "@recall/ui": ["packages/ui/src"],
      "@recall/i18n": ["packages/i18n/src"],
      "@recall/config": ["packages/config/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "build"]
}
